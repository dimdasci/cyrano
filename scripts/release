#!/usr/bin/env bash
# Releases a version: runs the quality gate, moves [Unreleased] in CHANGELOG.md into the
# version, commits both on release/<version> and opens a PR into main whose body is the release
# notes (main takes changes only through PRs). When the PR is merged,
# .github/workflows/release.yml tags the main commit v<version> and publishes the GitHub
# release, so the build number (the commit count) of a release only grows.
#
#   scripts/release 0.2.0
#
# See docs/releases.md.

set -euo pipefail
cd "$(dirname "$0")/.."

fail() {
  echo "$1" >&2
  exit 1
}

version=${1:-}
[[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "Usage: scripts/release <major.minor.patch>, e.g. 0.2.0"
tag="v$version"
branch="release/$version"

[[ $(git branch --show-current) == main ]] || fail "Run on main."
git diff --quiet && git diff --cached --quiet || fail "Commit or stash your changes first."
git fetch -q origin main --tags
git rev-parse -q --verify "refs/tags/$tag" >/dev/null && fail "Tag $tag already exists."
[[ $(git rev-parse HEAD) == $(git rev-parse origin/main) ]] ||
  fail "Local main differs from origin/main: run git pull first."

current=$(sed -n 's/^MARKETING_VERSION = //p' App/Version.xcconfig)
newest=$(printf '%s\n%s\n' "$current" "$version" | sort -V | tail -1)
[[ $version != "$current" && $newest == "$version" ]] ||
  fail "Version $version is not newer than the current $current."
git ls-remote --exit-code --heads origin "$branch" >/dev/null &&
  fail "Branch $branch already exists on origin: merge or close its PR first."

# On any failure before the commit, go back to a clean main.
git switch -q -c "$branch"
trap 'git checkout -q -- . && git switch -q main && git branch -q -D "$branch"' ERR
scripts/changelog release "$version"
sed -i '' "s/^MARKETING_VERSION = .*/MARKETING_VERSION = $version/" App/Version.xcconfig
scripts/check
git commit -q -m "Release $version" App/Version.xcconfig CHANGELOG.md
trap - ERR
git push -q -u origin "$branch"
gh pr create --base main --head "$branch" --title "Release $version" --body-file <(
  printf 'Sets the app version to %s. When merged, CI tags main %s and publishes these release notes:\n\n' \
    "$version" "$tag"
  scripts/changelog notes "$version"
)
git switch -q main

echo "Review the notes in the PR, then merge it; CI tags main $tag and publishes the release."

#!/usr/bin/env bash
# Releases a version: runs the quality gate, commits the version on release/<version> and
# opens a PR into main (main takes changes only through PRs). When the PR is merged,
# .github/workflows/tag.yml tags the main commit v<version>, so the build number (the commit
# count) of a release only grows.
#
#   scripts/release 0.2.0
#
# See docs/releases.md.

set -euo pipefail
cd "$(dirname "$0")/.."

fail() {
  echo "$1" >&2
  exit 1
}

version=${1:-}
[[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "Usage: scripts/release <major.minor.patch>, e.g. 0.2.0"
tag="v$version"
branch="release/$version"

[[ $(git branch --show-current) == main ]] || fail "Run on main."
git diff --quiet && git diff --cached --quiet || fail "Commit or stash your changes first."
git fetch -q origin main --tags
git rev-parse -q --verify "refs/tags/$tag" >/dev/null && fail "Tag $tag already exists."
[[ $(git rev-parse HEAD) == $(git rev-parse origin/main) ]] ||
  fail "Local main differs from origin/main: run git pull first."

current=$(sed -n 's/^MARKETING_VERSION = //p' App/Version.xcconfig)
newest=$(printf '%s\n%s\n' "$current" "$version" | sort -V | tail -1)
[[ $version != "$current" && $newest == "$version" ]] ||
  fail "Version $version is not newer than the current $current."
git ls-remote --exit-code --heads origin "$branch" >/dev/null &&
  fail "Branch $branch already exists on origin: merge or close its PR first."

scripts/check

git switch -q -c "$branch"
sed -i '' "s/^MARKETING_VERSION = .*/MARKETING_VERSION = $version/" App/Version.xcconfig
git commit -q -m "Release $version" App/Version.xcconfig
git push -q -u origin "$branch"
gh pr create --base main --head "$branch" --title "Release $version" \
  --body "Sets the app version to $version. When merged, CI tags main $tag."
git switch -q main

echo "Merge the PR; CI then tags main $tag."
